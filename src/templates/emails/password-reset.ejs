<%
  var expiryText = typeof expiresInMinutes !== 'undefined' ? expiresInMinutes + ' minutes' : (typeof expiresInHours !== 'undefined' ? expiresInHours + ' hours' : '1 hour');
%>

<h1 style="margin: 0 0 16px 0; font-size: 24px; font-weight: 800; color: #111827; letter-spacing: -0.5px;">
  Reset Your PulseBridge Password &#128274;
</h1>

<p style="margin: 0 0 16px 0; font-size: 15px; line-height: 24px; color: #374151;">
  Hello<%= typeof name !== 'undefined' && name ? ' ' + name : '' %>,
</p>

<p style="margin: 0 0 20px 0; font-size: 15px; line-height: 24px; color: #374151;">
  We received a request to reset your PulseBridge account password. Click the button below to choose a new, secure password:
</p>

<%- include('./partials/button', { label: 'Reset Password', url: resetUrl, color: '#DC2626' }) %>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 8px; margin-24px 0 16px 0;">
  <tr>
    <td style="padding: 16px;">
      <p style="margin: 0 0 8px 0; font-size: 13px; font-weight: 600; color: #374151;">If the button doesn't work, copy and paste this link into your browser:</p>
      <p style="margin: 0; font-size: 12px; line-height: 18px; word-break: break-all; color: #DC2626;">
        <a href="<%= resetUrl %>" style="color: #DC2626; text-decoration: underline;"><%= resetUrl %></a>
      </p>
    </td>
  </tr>
</table>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #FEF3C7; border-left: 4px solid #F59E0B; border-radius: 6px; margin: 16px 0;">
  <tr>
    <td style="padding: 14px 16px;">
      <p style="margin: 0; font-size: 13px; line-height: 20px; color: #92400E;">
        &#9888; <strong>Security Notice:</strong> This link is single-use and will expire in <strong><%= expiryText %></strong>. If you did not request a password reset, your account is still secure and you can safely ignore this email.
      </p>
    </td>
  </tr>
</table>
