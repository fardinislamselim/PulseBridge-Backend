<%
  var custName = typeof customerName !== 'undefined' && customerName ? customerName : (typeof name !== 'undefined' ? name : '');
  var txnId = typeof transactionId !== 'undefined' ? transactionId : (typeof invoiceId !== 'undefined' ? invoiceId : 'TXN-REFUND');
  var rDate = typeof date !== 'undefined' ? date : 'Recently';
  var refundAmt = typeof amount !== 'undefined' ? amount : '0.00';
  var refReason = typeof reason !== 'undefined' && reason ? reason : 'Administrative refund processed';
  var refStatus = typeof status !== 'undefined' ? status : 'REFUNDED';
%>

<div style="text-align: center; margin-bottom: 24px;">
  <span style="display: inline-block; background-color: #FEF3C7; color: #D97706; width: 64px; height: 64px; line-height: 64px; font-size: 32px; border-radius: 50%;">
    &#8634;
  </span>
</div>

<h1 style="margin: 0 0 16px 0; font-size: 24px; font-weight: 800; color: #111827; letter-spacing: -0.5px; text-align: center;">
  Payment Refund Processed &#128176;
</h1>

<p style="margin: 0 0 16px 0; font-size: 15px; line-height: 24px; color: #374151;">
  Hello<%= custName ? ' ' + custName : '' %>,
</p>

<p style="margin: 0 0 20px 0; font-size: 15px; line-height: 24px; color: #374151;">
  A refund has been initiated and processed for your payment on PulseBridge. Below are the details of the refund:
</p>

<!-- Refund details table -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 8px; margin-bottom: 24px;">
  <tr>
    <td style="padding: 20px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #6B7280; width: 40%;">Invoice / Transaction ID:</td>
          <td style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #111827; font-family: monospace;"><%= txnId %></td>
        </tr>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #6B7280;">Refund Amount:</td>
          <td style="padding: 6px 0; font-size: 18px; font-weight: 800; color: #D97706;"><%= refundAmt %></td>
        </tr>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #6B7280;">Status:</td>
          <td style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #111827;"><%= refStatus %></td>
        </tr>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #6B7280;">Reason:</td>
          <td style="padding: 6px 0; font-size: 13px; font-weight: 500; color: #4B5563;"><%= refReason %></td>
        </tr>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #6B7280;">Date:</td>
          <td style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #111827;"><%= rDate %></td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<p style="margin: 0 0 16px 0; font-size: 13px; line-height: 20px; color: #6B7280;">
  Depending on your card issuer or banking institution, funds typically reflect in your account within 5-10 business days.
</p>
