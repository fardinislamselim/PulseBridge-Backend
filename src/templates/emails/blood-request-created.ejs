<%
  var reqName = typeof requesterName !== 'undefined' ? requesterName : (typeof recipientName !== 'undefined' ? recipientName : '');
  var reqId = typeof requestId !== 'undefined' ? requestId : 'REQ-PENDING';
  var unitsVal = typeof unitsRequired !== 'undefined' ? unitsRequired : (typeof units !== 'undefined' ? units : 1);
  var urg = typeof urgency !== 'undefined' ? urgency : 'URGENT';
%>

<h1 style="margin: 0 0 16px 0; font-size: 24px; font-weight: 800; color: #111827; letter-spacing: -0.5px;">
  Blood Request Confirmed &#129656;
</h1>

<p style="margin: 0 0 16px 0; font-size: 15px; line-height: 24px; color: #374151;">
  Hello<%= reqName ? ' ' + reqName : '' %>,
</p>

<p style="margin: 0 0 20px 0; font-size: 15px; line-height: 24px; color: #374151;">
  Your blood request has been successfully created on PulseBridge and is now registered in our matching pipeline.
</p>

<!-- Request summary card -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 8px; margin-bottom: 24px;">
  <tr>
    <td style="padding: 20px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #6B7280; width: 40%;">Request ID:</td>
          <td style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #111827; font-family: monospace;"><%= reqId %></td>
        </tr>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #6B7280;">Blood Group:</td>
          <td style="padding: 6px 0; font-size: 14px; font-weight: 800; color: #DC2626;"><%= bloodGroup %></td>
        </tr>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #6B7280;">Units Required:</td>
          <td style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #111827;"><%= unitsVal %> Unit(s)</td>
        </tr>
        <% if (typeof patientName !== 'undefined' && patientName) { %>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #6B7280;">Patient Name:</td>
          <td style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #111827;"><%= patientName %></td>
        </tr>
        <% } %>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #6B7280;">Hospital:</td>
          <td style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #111827;"><%= hospitalName %></td>
        </tr>
        <% if (typeof contactNumber !== 'undefined' && contactNumber) { %>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #6B7280;">Contact Number:</td>
          <td style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #111827;"><%= contactNumber %></td>
        </tr>
        <% } %>
        <% if (typeof neededBy !== 'undefined' && neededBy) { %>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #6B7280;">Needed By:</td>
          <td style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #DC2626;"><%= neededBy %></td>
        </tr>
        <% } %>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #6B7280;">Urgency:</td>
          <td style="padding: 6px 0; font-size: 13px; font-weight: 700; color: <%= urg === 'EMERGENCY' ? '#DC2626' : (urg === 'URGENT' ? '#D97706' : '#2563EB') %>;"><%= urg %></td>
        </tr>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #6B7280;">Status:</td>
          <td style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #16A34A;"><%= typeof status !== 'undefined' ? status : 'PENDING' %></td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<%- include('./partials/button', { label: 'View Request Details', url: typeof requestUrl !== 'undefined' ? requestUrl : '#', color: '#DC2626' }) %>

<p style="margin: 20px 0 0 0; font-size: 13px; line-height: 20px; color: #6B7280;">
  Our system is actively notifying eligible donors nearby. You will receive updates as donors respond.
</p>
