<%
  var custName = typeof customerName !== 'undefined' && customerName ? customerName : (typeof name !== 'undefined' ? name : '');
  var txnId = typeof transactionId !== 'undefined' ? transactionId : (typeof invoiceId !== 'undefined' ? invoiceId : 'TXN-FAILED');
  var curr = typeof currency !== 'undefined' ? currency : 'BDT';
  var btnUrl = typeof retryUrl !== 'undefined' && retryUrl ? retryUrl : '#';
%>

<div style="text-align: center; margin-bottom: 24px;">
  <span style="display: inline-block; background-color: #FEE2E2; color: #DC2626; width: 64px; height: 64px; line-height: 64px; font-size: 32px; border-radius: 50%;">
    &#10008;
  </span>
</div>

<h1 style="margin: 0 0 16px 0; font-size: 24px; font-weight: 800; color: #111827; letter-spacing: -0.5px; text-align: center;">
  Payment Could Not Be Completed
</h1>

<p style="margin: 0 0 16px 0; font-size: 15px; line-height: 24px; color: #374151;">
  Hello<%= custName ? ' ' + custName : '' %>,
</p>

<p style="margin: 0 0 20px 0; font-size: 15px; line-height: 24px; color: #374151;">
  We were unable to process your payment transaction on PulseBridge. No funds were captured or deducted from your account.
</p>

<!-- Failure detail card -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #FEF2F2; border: 1px solid #FECACA; border-radius: 8px; margin-bottom: 24px;">
  <tr>
    <td style="padding: 20px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #991B1B; width: 40%;">Transaction ID:</td>
          <td style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #111827; font-family: monospace;"><%= txnId %></td>
        </tr>
        <% if (typeof amount !== 'undefined' && amount) { %>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #991B1B;">Amount:</td>
          <td style="padding: 6px 0; font-size: 14px; font-weight: 700; color: #111827;"><%= amount %> <%= curr %></td>
        </tr>
        <% } %>
        <% if (typeof failureReason !== 'undefined' && failureReason) { %>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #991B1B;">Reason:</td>
          <td style="padding: 6px 0; font-size: 13px; color: #7F1D1D;"><%= failureReason %></td>
        </tr>
        <% } %>
      </table>
    </td>
  </tr>
</table>

<%- include('./partials/button', { label: 'Retry Payment', url: btnUrl, color: '#DC2626' }) %>

<p style="margin: 20px 0 0 0; font-size: 13px; line-height: 20px; color: #6B7280; text-align: center;">
  If you continue encountering payment issues, please reach out to your financial provider or contact our support team.
</p>
