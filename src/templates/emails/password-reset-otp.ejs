<%
  var displayName = typeof name !== 'undefined' && name ? name : 'User';
  var expiryMinutes = typeof expiresInMinutes !== 'undefined' ? expiresInMinutes : 5;
%>

<div style="text-align: center; margin-bottom: 20px;">
  <span style="display: inline-block; background-color: #FEF3C7; color: #D97706; width: 56px; height: 56px; line-height: 56px; font-size: 28px; border-radius: 50%;">
    &#128274;
  </span>
</div>

<h1 style="margin: 0 0 16px 0; font-size: 24px; font-weight: 800; color: #111827; letter-spacing: -0.5px; text-align: center;">
  Password Reset Verification Code
</h1>

<p style="margin: 0 0 16px 0; font-size: 15px; line-height: 24px; color: #374151;">
  Hello <strong><%= displayName %></strong>,
</p>

<p style="margin: 0 0 24px 0; font-size: 15px; line-height: 24px; color: #374151;">
  We received a request to reset the password for your <strong>PulseBridge</strong> account. Use the 6-digit verification code below to authorize your password update:
</p>

<!-- OTP Display Card -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #FEF2F2; border: 2px dashed #F87171; border-radius: 12px; margin: 24px 0;">
  <tr>
    <td align="center" style="padding: 24px 16px;">
      <p style="margin: 0 0 8px 0; font-size: 12px; font-weight: 700; color: #991B1B; text-transform: uppercase; letter-spacing: 1.5px;">Password Reset Code</p>
      <div style="font-family: 'Courier New', Courier, monospace; font-size: 36px; font-weight: 800; color: #DC2626; letter-spacing: 10px; padding: 4px 0;">
        <%= otp %>
      </div>
      <p style="margin: 8px 0 0 0; font-size: 13px; color: #7F1D1D;">
        &#9200; Valid for <strong><%= expiryMinutes %> minutes</strong>
      </p>
    </td>
  </tr>
</table>

<!-- Security Warning Box -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #FEF3C7; border-left: 4px solid #F59E0B; border-radius: 6px; margin: 20px 0;">
  <tr>
    <td style="padding: 14px 16px;">
      <p style="margin: 0; font-size: 13px; line-height: 20px; color: #92400E;">
        &#9888; <strong>Security Warning:</strong> Your password will not change until this code is entered and a new password is submitted. Never disclose this code to anyone.
      </p>
    </td>
  </tr>
</table>

<p style="margin: 20px 0 0 0; font-size: 13px; line-height: 20px; color: #6B7280;">
  If you did not request a password reset, your account is still secure. You can safely ignore this email, or contact support if you suspect unauthorized activity.
</p>

<p style="margin: 24px 0 0 0; font-size: 14px; line-height: 22px; color: #4B5563;">
  Best regards,<br />
  <strong>PulseBridge Security & Support Team</strong>
</p>
