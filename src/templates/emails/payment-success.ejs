<%
  var custName = typeof customerName !== 'undefined' && customerName ? customerName : (typeof name !== 'undefined' ? name : '');
  var txnId = typeof transactionId !== 'undefined' ? transactionId : (typeof invoiceId !== 'undefined' ? invoiceId : 'TXN-SUCCESS');
  var pDate = typeof paymentDate !== 'undefined' ? paymentDate : (typeof date !== 'undefined' ? date : 'Recently');
  var method = typeof paymentMethod !== 'undefined' ? paymentMethod : 'Online Payment';
  var curr = typeof currency !== 'undefined' ? currency : 'BDT';
  var btnUrl = typeof receiptUrl !== 'undefined' && receiptUrl ? receiptUrl : '#';
%>

<div style="text-align: center; margin-bottom: 24px;">
  <span style="display: inline-block; background-color: #DCFCE7; color: #16A34A; width: 64px; height: 64px; line-height: 64px; font-size: 32px; border-radius: 50%;">
    &#10004;
  </span>
</div>

<h1 style="margin: 0 0 16px 0; font-size: 24px; font-weight: 800; color: #111827; letter-spacing: -0.5px; text-align: center;">
  Payment Successful &#128179;
</h1>

<p style="margin: 0 0 16px 0; font-size: 15px; line-height: 24px; color: #374151;">
  Hello<%= custName ? ' ' + custName : '' %>,
</p>

<p style="margin: 0 0 20px 0; font-size: 15px; line-height: 24px; color: #374151;">
  Your payment to PulseBridge has been successfully processed. Below are the details of your transaction receipt:
</p>

<!-- Payment receipt table -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 8px; margin-bottom: 24px;">
  <tr>
    <td style="padding: 20px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #6B7280; width: 40%;">Transaction ID:</td>
          <td style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #111827; font-family: monospace;"><%= txnId %></td>
        </tr>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #6B7280;">Amount Paid:</td>
          <td style="padding: 6px 0; font-size: 18px; font-weight: 800; color: #16A34A;"><%= amount %> <%= curr %></td>
        </tr>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #6B7280;">Payment Method:</td>
          <td style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #111827;"><%= method %></td>
        </tr>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #6B7280;">Date & Time:</td>
          <td style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #111827;"><%= pDate %></td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<%- include('./partials/button', { label: 'Download Tax Receipt', url: btnUrl, color: '#16A34A' }) %>

<p style="margin: 20px 0 0 0; font-size: 13px; line-height: 20px; color: #6B7280; text-align: center;">
  Thank you for supporting emergency assistance and healthcare coordination on PulseBridge.
</p>
