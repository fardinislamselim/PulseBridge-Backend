<%
  var unitsVal = typeof unitsRequired !== 'undefined' ? unitsRequired : (typeof units !== 'undefined' ? units : 1);
  var btnUrl = typeof actionUrl !== 'undefined' ? actionUrl : (typeof requestUrl !== 'undefined' ? requestUrl : '#');
  var donor = typeof donorName !== 'undefined' && donorName ? donorName : 'Valued Donor';
%>

<!-- Emergency banner -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #DC2626; border-radius: 8px; margin-bottom: 24px;">
  <tr>
    <td align="center" style="padding: 16px;">
      <span style="font-size: 18px; line-height: 20px; color: #FFFFFF; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">
        &#9888; URGENT EMERGENCY: CRITICAL BLOOD NEED
      </span>
    </td>
  </tr>
</table>

<h1 style="margin: 0 0 16px 0; font-size: 22px; font-weight: 800; color: #111827; letter-spacing: -0.5px;">
  Urgent Blood Needed: <%= bloodGroup %>
</h1>

<p style="margin: 0 0 16px 0; font-size: 15px; line-height: 24px; color: #374151;">
  Hello <strong><%= donor %></strong>,
</p>

<p style="margin: 0 0 20px 0; font-size: 15px; line-height: 24px; color: #374151;">
  An emergency blood request matching your blood group has just been raised near your location. A patient in critical condition urgently needs donor support.
</p>

<!-- Emergency detail card -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #FEF2F2; border: 2px solid #FECACA; border-radius: 8px; margin-bottom: 24px;">
  <tr>
    <td style="padding: 20px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
        <tr>
          <td style="padding: 8px 0; font-size: 14px; color: #991B1B; width: 40%; font-weight: 600;">Blood Group:</td>
          <td style="padding: 8px 0; font-size: 20px; font-weight: 900; color: #DC2626;"><%= bloodGroup %></td>
        </tr>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #7F1D1D;">Units Required:</td>
          <td style="padding: 6px 0; font-size: 14px; font-weight: 700; color: #111827;"><%= unitsVal %> Unit(s)</td>
        </tr>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #7F1D1D;">Hospital / Facility:</td>
          <td style="padding: 6px 0; font-size: 14px; font-weight: 700; color: #111827;"><%= hospitalName %></td>
        </tr>
        <% if (typeof hospitalAddress !== 'undefined' && hospitalAddress) { %>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #7F1D1D;">Address:</td>
          <td style="padding: 6px 0; font-size: 13px; color: #374151;"><%= hospitalAddress %></td>
        </tr>
        <% } %>
        <% if (typeof neededBy !== 'undefined' && neededBy) { %>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #7F1D1D;">Needed By:</td>
          <td style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #DC2626;"><%= neededBy %></td>
        </tr>
        <% } %>
        <% if (typeof contactNumber !== 'undefined' && contactNumber) { %>
        <tr>
          <td style="padding: 6px 0; font-size: 13px; color: #7F1D1D;">Emergency Contact:</td>
          <td style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #111827;"><%= contactNumber %></td>
        </tr>
        <% } %>
      </table>
    </td>
  </tr>
</table>

<%- include('./partials/button', { label: 'Respond to Emergency Request', url: btnUrl, color: '#DC2626' }) %>

<p style="margin: 20px 0 0 0; font-size: 12px; line-height: 18px; color: #6B7280; text-align: center;">
  Every minute counts during an emergency. If you are eligible and available to donate, please confirm as soon as possible.
</p>
