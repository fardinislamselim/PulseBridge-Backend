      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Success envelope validation\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.statusCode).to.eql(201);",
                  "    pm.expect(jsonData.message).to.be.a(\"string\");",
                  "    pm.expect(jsonData.data.user).to.be.an(\"object\");",
                  "});",
                  "if (jsonData.data && jsonData.data.user && jsonData.data.user.id) {",
                  "    pm.environment.set(\"userId\", jsonData.data.user.id);",
                  "}",
                  "pm.test(\"Response time is acceptable (< 2000ms)\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane.doe.{{$timestamp}}@example.com\",\n  \"password\": \"StrongPassword123!\",\n  \"phone\": \"01712345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a new user account with USER role and dispatches a verification token."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"success\": true,\n  \"statusCode\": 201,\n  \"message\": \"Registration successful. A verification OTP has been sent to your email. Please verify your account before logging in.\",\n  \"data\": {\n    \"email\": \"jane.doe@example.com\",\n    \"emailVerified\": false,\n    \"verificationRequired\": true\n  }\n}"
            }
          ]
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Success envelope validation\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.statusCode).to.eql(200);",
                  "    pm.expect(jsonData.message).to.be.a(\"string\");",
                  "    pm.expect(jsonData.data.user).to.be.an(\"object\");",
                  "});",
                  "if (jsonData.data && jsonData.data.user && jsonData.data.user.id) {",
                  "    pm.environment.set(\"userId\", jsonData.data.user.id);",
                  "}",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.environment.set(\"accessToken\", jsonData.data.accessToken);",
                  "}",
                  "if (jsonData.data && jsonData.data.refreshToken) {",
                  "    pm.environment.set(\"refreshToken\", jsonData.data.refreshToken);",
                  "}",
                  "// Extract accessToken from Set-Cookie header if present",
                  "const cookieHeader = pm.response.headers.get(\"Set-Cookie\");",
                  "if (cookieHeader) {",
                  "    const match = cookieHeader.match(/pb_access_token=([^;]+)/);",
                  "    if (match && match[1]) {",
                  "        pm.environment.set(\"accessToken\", match[1]);",
                  "    }",
                  "}",
                  "pm.test(\"Response time is acceptable (< 2000ms)\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
