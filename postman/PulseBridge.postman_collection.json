          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data && json.data.length > 0) {",
                  "    pm.collectionVariables.set(\"sessionId\", json.data[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Revoke Specific Session",
