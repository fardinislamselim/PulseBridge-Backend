            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"donor@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/resend-verification-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "resend-verification-otp"
              ]
            },
            "description": "Resends a fresh email verification OTP with 60s cooldown."
          }
        },
        {
          "name": "Login (User)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"donor@example.com\",\n  \"password\": \"StrongPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authenticates verified user. Automatically saves accessToken, refreshToken, and userId to collection variables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.success && json.data) {",
                  "    if (json.data.accessToken) {",
                  "        pm.collectionVariables.set(\"accessToken\", json.data.accessToken);",
                  "    }",
                  "    if (json.data.refreshToken) {",
                  "        pm.collectionVariables.set(\"refreshToken\", json.data.refreshToken);",
                  "    }",
                  "    if (json.data.user && json.data.user.id) {",
                  "        pm.collectionVariables.set(\"userId\", json.data.user.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authenticates default admin user (admin@pulsebridge.com). Automatically saves token to adminToken collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Admin login status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.success && json.data && json.data.accessToken) {",
                  "    pm.collectionVariables.set(\"adminToken\", json.data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
