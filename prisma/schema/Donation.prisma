model Donation {
  id                 String                     @id @default(uuid())
  assignmentId       String?                    @unique
  donorProfileId     String
  bloodRequestId     String
  verifiedById       String?
  unitsDonated       Int                        @default(1)
  donationDate       DateTime                   @default(now())
  donatedAt          DateTime?
  status             DonationStatus             @default(PENDING)
  verificationStatus DonationVerificationStatus @default(PENDING)
  hospitalName       String?
  hospitalAddress    String?
  notes              String?
  rejectionReason    String?
  verifiedAt         DateTime?
  completedAt        DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  // Relations
  assignment   DonorAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  donorProfile DonorProfile     @relation(fields: [donorProfileId], references: [id], onDelete: Restrict)
  bloodRequest BloodRequest     @relation(fields: [bloodRequestId], references: [id], onDelete: Restrict)
  verifiedBy   User?            @relation("VerifiedDonations", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([donorProfileId])
  @@index([bloodRequestId])
  @@index([verifiedById])
  @@index([status])
  @@index([verificationStatus])
  @@index([donationDate])
  @@index([completedAt])
  @@map("donations")
}
